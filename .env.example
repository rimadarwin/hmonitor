# Copia come .env e compila (non committare .env)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Opzionale: porta API in locale (python update_dates_api_server.py)
# UPDATE_DATES_API_PORT=8765

# Su Render imposta solo DATABASE_URL nella dashboard Environment.
# NON impostare PORT a mano: Render la assegna da solo al processo (gunicorn usa $PORT).

# API key per GET /partners/leads (chiamate interne server-to-server).
# Header: x-oj-api-key, X-Internal-Api-Key oppure Authorization: Bearer <chiave>
# PARTNERS_LEADS_API_KEY=genera-una-chiave-segreta
# PARTNERS_LEADS_CHANNEL=Lepas
# PARTNERS_LEADS_TOTAL=2316
# PARTNERS_LEADS_DEFAULT_LOCATION_ID=5fb4c022-8c7d-43dc-bf6d-3f1d4b19a26f
# PARTNERS_LEADS_DEFAULT_FIRST_NAME=stefano
# PARTNERS_LEADS_DEFAULT_LAST_NAME=sampietro
# PARTNERS_LEADS_DEFAULT_EMAIL=lead@example.com
